{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/oaa8/homeassistant_alpha/deako-simulator/messages.schema.json",
  "title": "Deako Protocol Messages",
  "description": "JSON Schema for Deako hub telnet protocol messages. Updated 2025-11-28 to match hardware-validated protocol from research/protocol-testing-2025-01-15.md",
  "oneOf": [
    {"$ref": "#/definitions/deviceListRequest"},
    {"$ref": "#/definitions/deviceListResponse"},
    {"$ref": "#/definitions/deviceFound"},
    {"$ref": "#/definitions/controlRequest"},
    {"$ref": "#/definitions/controlResponse"},
    {"$ref": "#/definitions/event"},
    {"$ref": "#/definitions/pingRequest"},
    {"$ref": "#/definitions/pingResponse"},
    {"$ref": "#/definitions/devicePollRequest"},
    {"$ref": "#/definitions/devicePollResponse"}
  ],
  "definitions": {
    "deviceListRequest": {
      "type": "object",
      "description": "Client requests total device count",
      "required": ["type", "transactionId"],
      "properties": {
        "type": {"const": "DEVICE_LIST"},
        "transactionId": {"type": "string"},
        "src": {"type": "string", "description": "Client identifier"},
        "dst": {"const": "deako"}
      },
      "additionalProperties": true
    },
    "deviceListResponse": {
      "type": "object",
      "description": "Hub responds with device count, followed by DEVICE_FOUND stream",
      "required": ["type", "transactionId", "status", "data", "timestamp"],
      "properties": {
        "type": {"const": "DEVICE_LIST"},
        "transactionId": {"type": "string"},
        "dst": {"type": "string", "description": "Client identifier (echoed from request src)"},
        "src": {"const": "deako"},
        "status": {"const": "ok"},
        "data": {
          "type": "object",
          "required": ["number_of_devices"],
          "properties": {
            "number_of_devices": {
              "type": "integer",
              "minimum": 0,
              "description": "Total number of devices"
            }
          },
          "additionalProperties": false
        },
        "timestamp": {
          "type": "integer",
          "description": "Unix timestamp in milliseconds"
        }
      },
      "additionalProperties": true
    },
    "deviceFound": {
      "type": "object",
      "description": "Hub announces device (unsolicited, sent after DEVICE_LIST response). Hardware-validated format from research/protocol-testing-2025-01-15.md",
      "required": ["type", "src", "data", "timestamp"],
      "properties": {
        "type": {"const": "DEVICE_FOUND"},
        "src": {"const": "deako"},
        "data": {
          "type": "object",
          "required": ["uuid", "name", "capabilities", "state"],
          "properties": {
            "uuid": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "name": {"type": "string", "description": "Human-readable device name"},
            "capabilities": {
              "type": "string",
              "enum": ["power", "power+dim"],
              "description": "Device capabilities as string (not array)"
            },
            "state": {
              "type": "object",
              "required": ["power"],
              "properties": {
                "power": {"type": "boolean", "description": "Current power state"},
                "dim": {
                  "type": ["integer", "null"],
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Current dim level (only present for power+dim devices)"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "timestamp": {"type": "integer"}
      },
      "additionalProperties": true
    },
    "controlRequest": {
      "type": "object",
      "description": "Client requests device state change",
      "required": ["type", "transactionId", "data"],
      "properties": {
        "type": {"const": "CONTROL"},
        "transactionId": {"type": "string"},
        "src": {"type": "string", "description": "Client identifier"},
        "dst": {"const": "deako"},
        "data": {
          "type": "object",
          "required": ["uuid"],
          "properties": {
            "uuid": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "power": {
              "type": "boolean",
              "description": "Desired power state"
            },
            "dim": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "Desired dim level (only for dimmable devices)"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "controlResponse": {
      "type": "object",
      "description": "Hub acknowledges control request (immediate ~100ms response)",
      "required": ["type", "transactionId", "status", "timestamp"],
      "properties": {
        "type": {"const": "CONTROL"},
        "transactionId": {"type": "string"},
        "dst": {"type": "string", "description": "Client identifier"},
        "src": {"const": "deako"},
        "status": {
          "enum": ["ok", "error"],
          "description": "ok if accepted, error if rejected"
        },
        "error": {
          "type": "string",
          "description": "Error description (only when status=error)"
        },
        "timestamp": {"type": "integer"}
      },
      "additionalProperties": true,
      "if": {
        "properties": {"status": {"const": "error"}}
      },
      "then": {
        "required": ["error"]
      }
    },
    "event": {
      "type": "object",
      "description": "Hub broadcasts device state change (unsolicited, sent to all connections). Hardware-validated format from research/protocol-testing-2025-01-15.md",
      "required": ["type", "src", "data", "timestamp"],
      "properties": {
        "type": {"const": "EVENT"},
        "src": {"const": "deako"},
        "data": {
          "type": "object",
          "required": ["eventType", "target", "state"],
          "properties": {
            "eventType": {
              "type": "string",
              "enum": ["DEVICE_STATE_CHANGE", "DEVICE_ADDED", "DEVICE_REMOVED"],
              "description": "Event type identifier"
            },
            "target": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "description": "UUID of the device that changed"
            },
            "state": {
              "type": "object",
              "required": ["power"],
              "properties": {
                "power": {"type": "boolean", "description": "New power state"},
                "dim": {
                  "type": ["integer", "null"],
                  "minimum": 0,
                  "maximum": 100,
                  "description": "New dim level (null if not dimmable)"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "timestamp": {"type": "integer"}
      },
      "additionalProperties": true
    },
    "pingRequest": {
      "type": "object",
      "description": "Client health check request",
      "required": ["type", "transactionId"],
      "properties": {
        "type": {"const": "PING"},
        "transactionId": {"type": "string"},
        "src": {"type": "string", "description": "Client identifier"},
        "dst": {"const": "deako"}
      },
      "additionalProperties": true
    },
    "pingResponse": {
      "type": "object",
      "description": "Hub echoes ping with timestamp",
      "required": ["type", "transactionId", "status", "timestamp"],
      "properties": {
        "type": {"const": "PING"},
        "transactionId": {"type": "string"},
        "dst": {"type": "string", "description": "Client identifier"},
        "src": {"const": "deako"},
        "status": {"const": "ok"},
        "timestamp": {"type": "integer"}
      },
      "additionalProperties": true
    },
    "devicePollRequest": {
      "type": "object",
      "description": "Client requests specific device state",
      "required": ["type", "transactionId", "data"],
      "properties": {
        "type": {"const": "DEVICE_POLL"},
        "transactionId": {"type": "string"},
        "src": {"type": "string", "description": "Client identifier"},
        "dst": {"const": "deako"},
        "data": {
          "type": "object",
          "required": ["target"],
          "properties": {
            "target": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "description": "UUID of device to poll"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "devicePollResponse": {
      "type": "object",
      "description": "Hub returns device state (FR-023: always returns status=error even on success)",
      "required": ["type", "transactionId", "status", "data", "timestamp"],
      "properties": {
        "type": {"const": "DEVICE_POLL"},
        "transactionId": {"type": "string"},
        "dst": {"type": "string", "description": "Client identifier"},
        "src": {"const": "deako"},
        "status": {
          "const": "error",
          "description": "QUIRK: Real hub always returns 'error' even on success (FR-023)"
        },
        "data": {
          "type": "object",
          "required": ["uuid", "name", "power"],
          "properties": {
            "uuid": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "name": {"type": "string"},
            "power": {"type": "boolean", "description": "Current power state"},
            "dim": {
              "type": ["integer", "null"],
              "minimum": 0,
              "maximum": 100,
              "description": "Current dim level (null if not dimmable)"
            }
          },
          "additionalProperties": false
        },
        "timestamp": {"type": "integer"}
      },
      "additionalProperties": true
    }
  },
  "examples": [
    {
      "description": "DEVICE_LIST request",
      "value": {
        "type": "DEVICE_LIST",
        "transactionId": "69e8f15b-8e20-4a2d-a9d0-baf6798ce88d",
        "src": "pydeako_default",
        "dst": "deako"
      }
    },
    {
      "description": "DEVICE_LIST response (hardware-validated)",
      "value": {
        "type": "DEVICE_LIST",
        "transactionId": "69e8f15b-8e20-4a2d-a9d0-baf6798ce88d",
        "dst": "pydeako_default",
        "src": "deako",
        "status": "ok",
        "data": {"number_of_devices": 37},
        "timestamp": 1760591917
      }
    },
    {
      "description": "DEVICE_FOUND (dimmable device, hardware-validated)",
      "value": {
        "type": "DEVICE_FOUND",
        "src": "deako",
        "timestamp": 1760591917,
        "data": {
          "name": "Master Bedroom Lights",
          "uuid": "50361c15-9739-4326-aded-24441cdbc75e",
          "capabilities": "power+dim",
          "state": {
            "power": true,
            "dim": 39
          }
        }
      }
    },
    {
      "description": "DEVICE_FOUND (switch-only device, hardware-validated)",
      "value": {
        "type": "DEVICE_FOUND",
        "src": "deako",
        "timestamp": 1760591917,
        "data": {
          "name": "Pantry Lights",
          "uuid": "08e8766e-1234-4567-89ab-cdef01234567",
          "capabilities": "power",
          "state": {
            "power": true
          }
        }
      }
    },
    {
      "description": "CONTROL request (power on, dim to 75%)",
      "value": {
        "type": "CONTROL",
        "transactionId": "ctrl-001",
        "src": "pydeako_default",
        "dst": "deako",
        "data": {
          "uuid": "a1b2c3d4-e5f6-4789-a012-b3c4d5e6f789",
          "power": true,
          "dim": 75
        }
      }
    },
    {
      "description": "CONTROL acknowledgment",
      "value": {
        "type": "CONTROL",
        "transactionId": "ctrl-001",
        "dst": "pydeako_default",
        "src": "deako",
        "status": "ok",
        "timestamp": 1729881234567
      }
    },
    {
      "description": "EVENT (device state change, hardware-validated)",
      "value": {
        "type": "EVENT",
        "src": "deako",
        "timestamp": 1760591877,
        "data": {
          "eventType": "DEVICE_STATE_CHANGE",
          "target": "0bbc7b01-3bf8-4c21-98e1-e2295f9b1935",
          "state": {
            "power": true,
            "dim": 75
          }
        }
      }
    },
    {
      "description": "PING request",
      "value": {
        "type": "PING",
        "transactionId": "ping-001",
        "src": "pydeako_default",
        "dst": "deako"
      }
    },
    {
      "description": "PING response",
      "value": {
        "type": "PING",
        "transactionId": "ping-001",
        "dst": "pydeako_default",
        "src": "deako",
        "status": "ok",
        "timestamp": 1760591917
      }
    }
  ]
}
